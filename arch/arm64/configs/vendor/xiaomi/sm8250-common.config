# Native 5.15 Xiaomi SM8250 platform/early-boot selections.
# Merge after gki_defconfig and vendor/kona_GKI.config. Development only.
# Initial peripheral selection only; not a boot-ready alioth defconfig.
# Overlay on the release Kona fragment after driver/source integration.
CONFIG_NFC_NQ=m
CONFIG_MACH_XIAOMI_ALIOTH=y
CONFIG_INPUT_MISC=y
CONFIG_INPUT_AW8697_HAPTIC=m

# Candidate native-DT boot dependencies; not yet a boot-tested configuration.
CONFIG_MACH_XIAOMI_ALIOTH=y
CONFIG_QCOM_SCM=y
CONFIG_QCOM_COMMAND_DB=y
CONFIG_QCOM_RPMH=y
CONFIG_QCOM_RPMHPD=y
CONFIG_QCOM_CLK_RPMH=y
CONFIG_SM_GCC_8250=y
CONFIG_PINCTRL_SM8250=y
CONFIG_SPMI_MSM_PMIC_ARB=y
CONFIG_MFD_SPMI_PMIC=y
CONFIG_REGULATOR_QCOM_RPMH=y
CONFIG_REGULATOR_FIXED_VOLTAGE=y
CONFIG_INTERCONNECT_QCOM=y
CONFIG_INTERCONNECT_QCOM_SM8250=y
CONFIG_PHY_QCOM_QMP=y
CONFIG_PHY_QCOM_QUSB2=y
CONFIG_SCSI_UFS_QCOM=y
CONFIG_QCOM_GENI_SE=y
CONFIG_SERIAL_QCOM_GENI=y
CONFIG_SERIAL_QCOM_GENI_CONSOLE=y
CONFIG_QCOM_DMABUF_HEAPS=y
CONFIG_ALIOTH_ION_COMPAT=y
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_QCOM=y
CONFIG_COMMON_CLK_QCOM=y
CONFIG_PINCTRL_MSM=y
CONFIG_QCOM_AOSS_QMP=y
CONFIG_QCOM_SMEM=y
CONFIG_QCOM_PDC=y
CONFIG_PINCTRL_QCOM_SPMI_PMIC=y
CONFIG_TOUCHSCREEN_SUPPORT_NEW_GAME_MODE=y
CONFIG_SPI_QCOM_GENI=y
CONFIG_I2C_QCOM_GENI=y
CONFIG_QCOM_GPI_DMA=y
CONFIG_INPUT_TOUCHSCREEN=y
CONFIG_TOUCHSCREEN_XIAOMI_TOUCHFEATURE=y
CONFIG_TOUCHSCREEN_FOCALTECH=y
CONFIG_INPUT_FINGERPRINT=y
CONFIG_FINGERPRINT_FPC=y
CONFIG_FINGERPRINT_GOODIX=y
CONFIG_XIAOMI_DRM_NOTIFIER=y
CONFIG_NFC_NQ=y
CONFIG_INPUT_MISC=y
CONFIG_INPUT_AW8697_HAPTIC=y

# Early built-in heap/clock dependency closure.
CONFIG_IPC_LOGGING=y
CONFIG_REGMAP_QTI_DEBUGFS=y
CONFIG_QCOM_GDSC_REGULATOR=y
CONFIG_QCOM_MEM_BUF=y
CONFIG_QCOM_MEM_BUF_DEV=y
CONFIG_QCOM_SECURE_BUFFER=y
CONFIG_QCOM_IOMMU_UTIL=y
CONFIG_QTI_IOMMU_SUPPORT=y
CONFIG_QCOM_IOMMU_DEBUG=y
CONFIG_ARM_SMMU=y
CONFIG_ARM_SMMU_QCOM=y
CONFIG_REGULATOR_RPMH=y

# Alioth infrared transmitter.
CONFIG_RC_CORE=y
CONFIG_RC_DEVICES=y
CONFIG_IR_SPI=y

CONFIG_REGULATOR_PROXY_CONSUMER=y

# Storage/interconnect built-in provider closure.
CONFIG_QCOM_LAZY_MAPPING=y
CONFIG_QCOM_MINIDUMP=y
CONFIG_QCOM_MINIDUMP_SMEM=y
CONFIG_PHY_QCOM_UFS=y
CONFIG_PHY_QCOM_UFS_V4=y
CONFIG_SCSI_UFS_CRYPTO_QTI=y
CONFIG_QTI_CRYPTO_COMMON=y
CONFIG_INTERCONNECT_QCOM_DEBUG=y
CONFIG_QCOM_SOCINFO=y

CONFIG_QTI_CRYPTO_TZ=y

# Physical keys: PM8150 PON power/resin plus PMIC GPIO6 volume-up.
CONFIG_INPUT_KEYBOARD=y
CONFIG_KEYBOARD_GPIO=y
CONFIG_INPUT_PM8941_PWRKEY=y

# KGSL clock/corner and efuse prerequisites.
CONFIG_SM_GPUCC_8250=y
CONFIG_NVMEM_QFPROM=y

CONFIG_QCOM_KONA_QSEE_IRQ=y
CONFIG_QCOM_APCS_IPC=y

CONFIG_QSEE_IPC_IRQ_BRIDGE=m

# Vendor ueventd supplies modem-mounted firmware.
CONFIG_FW_LOADER_USER_HELPER_FALLBACK=y

# The native 7nm HS PHY binding uses the generic PHY API (DWC3/QMP are built in).
CONFIG_PHY_QCOM_USB_SNPS_FEMTO_V2=y
